# 复制本文件为 .env 并按需修改

# 数据库连接串（SQLite 起步，后续可迁移 MySQL）
DATABASE_URL=sqlite:///./herb_ai.db

# CORS 允许来源（逗号分隔；开发期前端 Vite 默认 5173）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 应用调试开关
DEBUG=true

# 百度植物识别 API 凭证（在百度智能云创建应用获取）
BAIDU_API_KEY=your_api_key
BAIDU_SECRET_KEY=your_secret_key
# 置为 true 启用百度识别；未配置凭证时自动回退 Mock
BAIDU_ENABLED=true
# 百度相似品种 top-k 数量（低置信度降级列表展示用）
BAIDU_TOP_K=5

# 通义千问（Qwen）多模态问答凭证（在阿里云百炼获取 API Key）
QWEN_API_KEY=your_qwen_api_key
# 置为 true 启用 Qwen 问答；未配置凭证时自动降级为知识库结构化展示
QWEN_ENABLED=true
# Qwen 模型（OpenAI 兼容协议模型名）
QWEN_MODEL=qwen-plus
# Qwen OpenAI 兼容接口 base_url：
#   - 标准 DashScope：https://dashscope.aliyuncs.com/compatible-mode/v1
#   - 专属云（MaaS 定制域名）：https://ws-xxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Qwen 调用超时（秒）：超时即降级，避免阻塞结果页（专属云首调建议 ≥30）
QWEN_TIMEOUT=30.0
