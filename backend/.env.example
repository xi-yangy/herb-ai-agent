# 复制本文件为 .env 并按需修改

# 数据库连接串（SQLite 起步，后续可迁移 MySQL）
DATABASE_URL=sqlite:///./herb_ai.db

# CORS 允许来源（逗号分隔；开发期前端 Vite 默认 5173）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 应用调试开关
DEBUG=true

# 百度植物识别 API 凭证（在百度智能云创建应用获取）
BAIDU_API_KEY=your_api_key
BAIDU_SECRET_KEY=your_secret_key
# 置为 true 启用百度识别；未配置凭证时自动回退 Mock
BAIDU_ENABLED=true

# ==== 本地自建模型（主通道）配置 ====
# 默认禁用。若未放置模型文件，即使置 true 也会如实回退百度/Mock（不会虚标识别结果）。
MODEL_ENABLED=false
# 模型文件路径（onnx 或 pytorch .pt/.pth），如 ./models/herb_classifier.onnx
MODEL_PATH=
# 类别清单文件路径（一行一类 或 JSON 数组，顺序与模型输出对齐），如 ./models/labels.txt
MODEL_LABELS=
# 本地模型置信度阈值：低于该值触发百度兜底/相似品种降级
MODEL_CONFIDENCE_THRESHOLD=0.6
# 相似品种 top-k 数量（本地与百度共用）
MODEL_TOP_K=5
